{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=devstation;Username=devstation;Password=devstation"
  },
  "Jobs": [
    {
      "name": "health-sweep",
      "description": "Run all enabled health checks (same as a poller tick)",
      "cron": "0 */2 * * * ?",
      "timezone": "UTC",
      "type": "health-sweep"
    },
    {
      "name": "log-cleanup",
      "description": "Prune health_check_results older than 7 days",
      "cron": "0 0 3 * * ?",
      "timezone": "UTC",
      "type": "log-cleanup"
    }
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
